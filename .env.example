# ─────────────────────────────────────────────────────────────
# Al-Kunooz website — environment variables
# Copy to `.env.local` (development) or set in your hosting dashboard.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Public contact details (leave empty until confirmed by the company) ──
# When empty, the site hides WhatsApp/phone buttons and shows "Coming soon".
# WhatsApp number in international format, digits only (e.g. 2499XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as it should be displayed (e.g. +249 9X XXX XXXX).
NEXT_PUBLIC_PHONE=
# Public email address.
NEXT_PUBLIC_EMAIL=

# ── Inquiry form delivery (server-only secrets) ──
# Configure SMTP and/or a webhook. If neither is set, the form shows a
# "not enabled yet" message in production (and logs to the console in development).

# SMTP (e.g. Google Workspace, Zoho, Mailgun, your hosting provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where inquiries are sent, and the From address.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Webhook alternative: receives a JSON POST for each inquiry
# (Zapier, Make, n8n, Google Apps Script → Google Sheets, etc.)
INQUIRY_WEBHOOK_URL=
